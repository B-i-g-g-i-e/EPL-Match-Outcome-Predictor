# Virtual environments (installed libraries, too large for GitHub)
venv/
.venv/

# Python cache files (auto-generated when running scripts)
__pycache__/
*.py[cod]

# Environment variables (keeps API keys or secrets private)
.env

# Test cache (created by pytest)
.pytest_cache/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Trained model files (large, and regenerated by src/train.py)
models/*.pkl

# Generated data (rebuilt by data_loader.py, features.py and train.py)
data/processed/